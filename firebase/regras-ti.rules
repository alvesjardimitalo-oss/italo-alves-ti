    // ---------- Ítalo Alves TI (assistência técnica · repo italo-alves-ti) ----------
    // Só o dono acessa. Dados em ti/base/{colecao}/{doc} e ti/base/meta/{config|contadores}.
    function tiDono() {
      return signedIn()
        && myEmail() in ['alvesjardim.italo@gmail.com']
        && request.auth.token.email_verified == true;
    }
    match /ti/{document=**} {
      allow read, write: if tiDono();
    }
    // Site público: qualquer visitante pode CRIAR um pedido ("Fale comigo"),
    // mas não pode ler, alterar nem apagar. Campos e tamanhos travados.
    function tiTexto(d, campo, max) {
      return !(campo in d) || (d[campo] is string && d[campo].size() <= max);
    }
    match /ti/base/leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'whatsapp', 'cidade', 'equipamento', 'problema',
                         'detalhe', 'atendimento', 'servico', 'origem', 'utm', 'indicacao', 'status', 'criadoEm'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 80
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.matches('^[0-9]{10,13}$')
        && tiTexto(request.resource.data, 'cidade', 80)
        && tiTexto(request.resource.data, 'equipamento', 40)
        && tiTexto(request.resource.data, 'problema', 60)
        && tiTexto(request.resource.data, 'detalhe', 1500)
        && tiTexto(request.resource.data, 'atendimento', 40)
        && tiTexto(request.resource.data, 'servico', 40)
        && tiTexto(request.resource.data, 'origem', 120)
        && tiTexto(request.resource.data, 'utm', 120)
        && tiTexto(request.resource.data, 'indicacao', 60)
        && request.resource.data.status == 'Novo'
        && request.resource.data.criadoEm == request.time;
    }
    // Métricas sem dados pessoais: só CRIAÇÃO de eventos com campos fixos.
    // A leitura permanece restrita ao dono pela regra match /ti/{document=**}.
    // IMPORTANTE: regras não fazem rate limit; acompanhar cotas/abuso do Firestore.
    // Não ativar enforcement geral do App Check do projeto high-os sem adaptar os outros apps.
    match /ti/base/metricasSite/{eventoId} {
      allow create: if request.resource.data.keys().hasOnly(['tipo', 'categoria', 'pagina', 'canal', 'criadoEm'])
        && request.resource.data.keys().hasAll(['tipo', 'categoria', 'pagina', 'canal', 'criadoEm'])
        && request.resource.data.tipo in ['visita', 'chat_aberto', 'sintoma_selecionado',
                      'ferramenta_iniciada', 'ferramenta_concluida', 'whatsapp_aberto']
        && request.resource.data.categoria is string
        && request.resource.data.categoria.matches('^[a-z0-9-]{0,36} o visitante só LÊ um documento se souber o ID exato
    // (hash do código da OS + telefone). Não dá para listar nem gravar.
    match /ti/base/rastreio/{rastreioId} {
      allow get: if true;
    }
)
        && request.resource.data.pagina in ['inicio', 'ferramentas', 'dicas', 'atendimento', 'acompanhar', 'institucional']
        && request.resource.data.canal in ['social', 'whatsapp', 'busca', 'email', 'referencia', 'direto']
        && request.resource.data.criadoEm == request.time;
    }
    // Black Friday da Karen: reserva de estoque do carrinho (10 minutos para pagar o Pix).
    // Público: CRIAR uma reserva (só código do pedido, itens e horário, sem dados pessoais)
    // e LER as reservas para calcular o estoque disponível. Alterar/apagar: só o dono.
    function tiQtd(itens, foto) {
      return !(foto in itens) || (itens[foto] is int && itens[foto] >= 1 && itens[foto] <= 5);
    }
    match /ti/base/reservas-bf/{reservaId} {
      allow get: if true;
      allow list: if request.query.limit <= 300;
      allow create: if reservaId.matches('^P[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['pedido', 'itens', 'criadoEm'])
        && request.resource.data.pedido == reservaId
        && request.resource.data.criadoEm == request.time
        && request.resource.data.itens is map
        && request.resource.data.itens.size() >= 1
        && request.resource.data.itens.keys().hasOnly(['floratta-fleur-eclipse', 'clash-extreme', 'kaiak-extremo', 'humor-envolve', 'meu-primeiro-humor', 'floratta-blue-crystal', '300kmh-max-turbo'])
        && tiQtd(request.resource.data.itens, 'floratta-fleur-eclipse')
        && tiQtd(request.resource.data.itens, 'clash-extreme')
        && tiQtd(request.resource.data.itens, 'kaiak-extremo')
        && tiQtd(request.resource.data.itens, 'humor-envolve')
        && tiQtd(request.resource.data.itens, 'meu-primeiro-humor')
        && tiQtd(request.resource.data.itens, 'floratta-blue-crystal')
        && tiQtd(request.resource.data.itens, '300kmh-max-turbo');
    }
    // "Acompanhar OS": o visitante só LÊ um documento se souber o ID exato
    // (hash do código da OS + telefone). Não dá para listar nem gravar.
    match /ti/base/rastreio/{rastreioId} {
      allow get: if true;
    }
