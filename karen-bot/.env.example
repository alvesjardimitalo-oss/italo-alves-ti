# Bot da Karen — copie para .env (fica SÓ no seu PC, nunca no GitHub).
# Token do bot (Discord Developer Portal › seu app › Bot › Reset Token).
DISCORD_TOKEN=
# ID do servidor (Discord › botão direito no ícone do servidor › Copiar ID do servidor).
DISCORD_GUILD_ID=
# Chave da conta de serviço do Firebase (projeto high-os), em UMA linha só.
# Pode ser a mesma do bot do High OS (HIGH_OS_FIREBASE_SERVICE_ACCOUNT_JSON).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Opcionais
PORT=3100
INTERVALO_SEGUNDOS=90

# Revendi (só leitura: crediário e totais de vendas). Use o usuário de integração, com leitura em
# Vendas ("ver vendas de todos"), Clientes e Financeiro. Para ligar: REVENDI_ATIVO=sim
REVENDI_ATIVO=
REVENDI_EMAIL=
REVENDI_SENHA=
# Opcionais
REVENDI_API_URL=https://api.revendi.app/api
REVENDI_MINUTOS=30
REVENDI_DDD_PADRAO=33
